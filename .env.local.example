# Pattern Lab — local environment config
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── AI (required for Generate Pattern) ────────────────────────────────────────
# Get a key at https://openrouter.ai  (free tier available)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override the model used for generation.
# Good choices via OpenRouter:
#   openai/gpt-4o-mini       — fast and cheap (default)
#   openai/gpt-4o             — higher quality
#   anthropic/claude-3-5-haiku — Claude, very good at structured JSON
#   google/gemini-flash-1.5   — fast and free-tier friendly
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Ports (optional, change only if there are conflicts) ──────────────────────
# API_PORT=5000
# FRONTEND_PORT=3001
